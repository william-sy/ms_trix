{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "share-bar",
    "share-draw",
    "talk-call-window",
    "reminder"
  ],
  "webviews": [
    "talk-call"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-badge-count",
    "notification:default",
    "core:window:allow-start-dragging"
  ]
}
